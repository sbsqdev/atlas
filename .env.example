# DeepSeek API key for /api/infer-muscles (set in Vercel: vercel env add DEEPSEEK_API_KEY)
DEEPSEEK_API_KEY=

# Resend API key for /api/send-reminder (habit e-mail reminders).
# Set in Vercel:  vercel env add RESEND_API_KEY
RESEND_API_KEY=
# Verified sender, e.g. "Human Atlas <reminders@yourdomain.kz>".
# Optional — defaults to Resend's onboarding sender for testing.
REMINDER_FROM=
