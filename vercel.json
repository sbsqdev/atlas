{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/academy",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/academy/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|atlas/|assets/|models/|landing/|materials/|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
