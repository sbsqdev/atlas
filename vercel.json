{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.fab3d-scan.com"
        }
      ],
      "destination": "https://pitch-ustoz.vercel.app/pitch/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "fab3d-scan.com"
        }
      ],
      "destination": "https://pitch-ustoz.vercel.app/pitch/",
      "permanent": false
    },
    {
      "source": "/academy/:path+",
      "destination": "/:path+",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|atlas/|assets/|models/|landing/|materials/|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
